{
  "name": "omp-web",
  "version": "0.18.0",
  "description": "Web view for the omp (oh-my-pi) coding agent CLI",
  "homepage": "https://github.com/ddallabenetta/omp-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddallabenetta/omp-web.git"
  },
  "bugs": {
    "url": "https://github.com/ddallabenetta/omp-web/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.4"
  },
  "bin": {
    "omp-web": "bin/omp-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "scripts/run-next.mjs",
    "package.json"
  ],
  "scripts": {
    "dev": "bun run scripts/run-next.mjs dev --webpack -H 127.0.0.1 -p 30141",
    "dev:lan": "bun run scripts/run-next.mjs dev --webpack -H 0.0.0.0 -p 30141",
    "build": "bun run scripts/run-next.mjs build --webpack",
    "start": "bun run scripts/run-next.mjs start -H 127.0.0.1 -p 30141",
    "start:lan": "bun run scripts/run-next.mjs start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun test",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "desktop:build": "bun scripts/stage-desktop.mjs && bun scripts/build-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:fetch-bun": "bun scripts/fetch-bun.mjs",
    "desktop:signer": "tauri signer",
    "desktop:sync-version": "bun scripts/sync-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "18.14.0",
    "@oh-my-pi/pi-ai": "18.14.0",
    "@oh-my-pi/pi-coding-agent": "18.14.0",
    "@oh-my-pi/pi-tui": "18.14.0",
    "@oh-my-pi/pi-utils": "18.14.0",
    "@pierre/diffs": "^1.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.55.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "radix-ui": "^1.8.0",
    "react": "^19.2.8",
    "react-arborist": "^4.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.4",
    "react-virtuoso": "^4.18.16",
    "remark-frontmatter": "^5.0.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "undici": "8.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
